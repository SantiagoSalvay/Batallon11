{"nodes": [{"id": "claude_gate_token_auth", "label": "Gate Token Admin Access", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No public login form: admin access starts from a one-time gate token URL that exchanges for a short-lived session."}, {"id": "claude_role_stage_scoping", "label": "Role and Stage Scoping", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "COORDINATOR accounts are pinned to one stage so they can never touch another stage's content."}, {"id": "claude_stages_static_config", "label": "Stages as Static Config", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The six etapas are fixed in shared/stagesData.json rather than a DB table, so adding one is an edit not a migration."}, {"id": "claude_dual_content_model", "label": "General vs Per-Stage Content Model", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Posts and galleries exist twice, general and per-stage, mirrored across controllers, routes and admin pages; a fix in one usually needs the sibling."}, {"id": "claude_image_pipeline", "label": "Image Upload Pipeline", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "multer then sharp resize/optimize with metadata stripped, stored on local disk or Supabase Storage."}, {"id": "claude_security_posture", "label": "Hardened Security Posture", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_