generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Usuario {
  id                Int                  @id @default(autoincrement())
  email             String               @unique
  password          String
  name              String?
  role              Rol                  @default(ADMIN)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  tokenVersion      Int                  @default(0)
  totpEnabled       Boolean              @default(false)
  totpSecret        String?
  stageSlug         String?
  codigosRespaldo   CodigoRespaldoTotp[]
  codigosTotpUsados CodigoTotpUsado[]
  sesionesRefresco  SesionRefresco[]

  @@index([stageSlug])
  @@map("usuarios")
}

model SesionRefresco {
  id        String    @id @default(cuid())
  userId    Int
  tokenHash String
  jti       String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  ip        String?
  userAgent String?
  usuario   Usuario   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sesiones_refresco")
}

model JtiAccesoRevocado {
  jti       String   @id
  expiresAt DateTime

  @@index([expiresAt])
  @@map("jti_acceso_revocado")
}

model Publicacion {
  id        Int                 @id @default(autoincrement())
  title     String              @map("titulo")
  content   String              @map("contenido")
  published Boolean             @default(true) @map("publicada")
  createdAt DateTime            @default(now()) @map("creadaEn")
  updatedAt DateTime            @updatedAt @map("actualizadaEn")
  stageSlug String?             @map("etapaSlug")
  imagenes  ImagenPublicacion[]

  @@index([stageSlug, createdAt])
  @@map("publicaciones")
}

model ImagenPublicacion {
  id               String      @id
  publicacionId    Int
  rutaOriginal     String?
  rutaOptimizada   String
  nombreOriginal   String?
  tipoMimeOriginal String?
  tamanoOriginal   Int?
  tamanoOptimizado Int?
  ancho            Int?
  alto             Int?
  caption          String?     @map("leyenda")
  order            Int         @default(0) @map("orden")
  createdAt        DateTime    @default(now()) @map("creadaEn")
  publicacion      Publicacion @relation(fields: [publicacionId], references: [id], onDelete: Cascade)

  @@index([publicacionId, order])
  @@map("imagenes_publicacion")
}

model ImagenGaleria {
  id        Int      @id @default(autoincrement())
  imageUrl  String
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([order])
  @@map("imagenes_galeria")
}

model ImagenGaleriaEtapa {
  id        Int      @id @default(autoincrement())
  imageUrl  String
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  stageSlug String

  @@index([stageSlug, order])
  @@map("imagenes_galeria_etapa")
}

model Evento {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  imageUrl    String?
  location    String?
  date        DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@map("eventos")
}

model DesafioAccesoAdmin {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([expiresAt])
  @@map("desafios_acceso_admin")
}

model CodigoTotpUsado {
  id        String   @id @default(cuid())
  userId    Int
  codeHash  String
  usedAt    DateTime @default(now())
  expiresAt DateTime
  usuario   Usuario  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, codeHash])
  @@index([expiresAt])
  @@map("codigos_totp_usados")
}

model CodigoRespaldoTotp {
  id        String    @id @default(cuid())
  userId    Int
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  usuario   Usuario   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("codigos_respaldo_totp")
}

enum Rol {
  ADMIN
  EDITOR
  COORDINATOR
}
