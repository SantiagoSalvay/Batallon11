generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              Int              @id @default(autoincrement())
  email           String           @unique
  password        String
  name            String?
  role            Role             @default(ADMIN)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  tokenVersion    Int              @default(0)
  totpEnabled     Boolean          @default(false)
  totpSecret      String?
  stageSlug       String?
  refreshSessions RefreshSession[]

  @@index([stageSlug])
  @@map("users")
}

model RefreshSession {
  id        String    @id @default(cuid())
  userId    Int
  tokenHash String
  jti       String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  ip        String?
  userAgent String?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

model RevokedAccessJti {
  jti       String   @id
  expiresAt DateTime

  @@index([expiresAt])
  @@map("revoked_access_jti")
}

/// URLs de logo/portada subidas por etapa (metadatos de etapa están en shared/stages.js).
model StageMedia {
  slug      String   @id
  logoUrl   String?
  coverUrl  String?
  updatedAt DateTime @updatedAt

  @@map("stage_media")
}

model Post {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  imageUrl  String?
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@map("posts")
}

model StagePost {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  imageUrl  String?
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  stageSlug String

  @@index([stageSlug, createdAt])
  @@map("stage_posts")
}

model GalleryImage {
  id        Int      @id @default(autoincrement())
  imageUrl  String
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([order])
  @@map("gallery_images")
}

model StageGalleryImage {
  id        Int      @id @default(autoincrement())
  imageUrl  String
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  stageSlug String

  @@index([stageSlug, order])
  @@map("stage_gallery_images")
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  imageUrl    String?
  location    String?
  date        DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@map("events")
}

enum Role {
  ADMIN
  EDITOR
  COORDINATOR
}
