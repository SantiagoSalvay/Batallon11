generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              Int              @id @default(autoincrement())
  email           String           @unique
  password        String
  name            String?
  role            Role             @default(ADMIN)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  tokenVersion    Int              @default(0)
  totpEnabled     Boolean          @default(false)
  totpSecret      String?
  stageSlug       String?
  refreshSessions RefreshSession[]
  backupCodes     TotpBackupCode[]
  usedTotpCodes   UsedTotpCode[]

  @@index([stageSlug])
  @@map("usuarios")
}

model RefreshSession {
  id        String    @id @default(cuid())
  userId    Int
  tokenHash String
  jti       String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  ip        String?
  userAgent String?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sesiones_refresco")
}

model RevokedAccessJti {
  jti       String   @id
  expiresAt DateTime

  @@index([expiresAt])
  @@map("jti_acceso_revocado")
}

model Publicacion {
  id            Int                 @id @default(autoincrement())
  titulo        String
  contenido     String
  publicada     Boolean             @default(true)
  etapaSlug     String?
  creadaEn      DateTime            @default(now())
  actualizadaEn DateTime            @updatedAt
  imagenes      ImagenPublicacion[]

  @@index([etapaSlug, creadaEn])
  @@map("publicaciones")
}

model ImagenPublicacion {
  id               String      @id @default(cuid())
  publicacionId    Int
  rutaOriginal     String?
  rutaOptimizada   String
  nombreOriginal   String?
  tipoMimeOriginal String?
  tamanoOriginal   Int?
  tamanoOptimizado Int?
  ancho            Int?
  alto             Int?
  leyenda          String?
  orden            Int         @default(0)
  creadaEn         DateTime    @default(now())
  publicacion      Publicacion @relation(fields: [publicacionId], references: [id], onDelete: Cascade)

  @@index([publicacionId, orden])
  @@map("imagenes_publicacion")
}

model GalleryImage {
  id        Int      @id @default(autoincrement())
  imageUrl  String
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([order])
  @@map("imagenes_galeria")
}

model StageGalleryImage {
  id        Int      @id @default(autoincrement())
  imageUrl  String
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  stageSlug String

  @@index([stageSlug, order])
  @@map("imagenes_galeria_etapa")
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  imageUrl    String?
  location    String?
  date        DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@map("eventos")
}

model AdminAccessChallenge {
  id        String    @id
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([expiresAt])
  @@map("desafios_acceso_admin")
}

model UsedTotpCode {
  id        String   @id
  userId    Int
  codeHash  String
  usedAt    DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId, codeHash])
  @@map("codigos_totp_usados")
}

model TotpBackupCode {
  id        String    @id
  userId    Int
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("codigos_respaldo_totp")
}

enum Role {
  ADMIN
  EDITOR
  COORDINATOR

  @@map("Rol")
}
